# Shell and terminal basics
shell -$SHELL
startup_message off
truecolor on
utf8 on
encoding UTF-8
term screen-256color
bce "on"
altscreen on
scrollback 10000
ignorecase on
mousetrack on

# Ctrl-a is the prefix, as in .tmux.conf.
# Ctrl-a Ctrl-a switches to the previous window; Ctrl-a a sends a literal Ctrl-a.
escape ^Aa
bind ^A other
bind a meta

# Split, focus the new region, and start a shell in it.
bind s eval "split" "focus down" "screen"
bind | eval "split -v" "focus right" "screen"

# Vim-style movement between regions
bind h focus left
bind j focus down
bind k focus up
bind l focus right

# Resize by five cells: +/- grows/shrinks height, >/< grows/shrinks width.
bind + resize -v +5
bind - resize -v -5
bind > resize -h +5
bind < resize -h -5
bind = resize -b =

# Clear the former resize keys on reload, including their Screen defaults.
bind H
bind J
bind K
bind L
bind _ silence
bind r wrap
bind R fit

# Kill the shell and remove its region after confirmation. Bare Ctrl-d only
# exits the shell; Screen does not automatically remove its region.
bind x eval 'echo "Kill this pane? (y/n)"' 'command -c close-pane'
bind -c close-pane y eval "kill" "remove"
bind -c close-pane n redisplay
bind -c close-pane ^[ redisplay

# Screen windows already exist independently of regions: hide this region
# without killing its shell, then select the window elsewhere with Ctrl-a ".
bind b remove

# Quit the whole session after confirmation, as in .tmux.conf.
bind X eval 'echo "Kill all windows in this session? (y/n)"' 'command -c close-session'
bind ^\ eval 'echo "Kill all windows in this session? (y/n)"' 'command -c close-session'
bind -c close-session y quit
bind -c close-session n redisplay
bind -c close-session ^[ redisplay

# Window selection, copy mode, renaming, and scrollback size
# The default c, n, p, and digit bindings still create/select windows.
bind '"' windowlist -b
bind ^[ copy
bind , title
bind y colon "scrollback "

# Keep the session and window list visible, plus the existing window chooser.
hardstatus alwayslastline '[%S] %w'
windowlist title '     %{G}%H %{d}: %{C}%S%{d}%=CPU averages [1m 5m 15m] [%l]'
windowlist string "%{b}%3n)%{6} %h %=%f"

silencewait 600

rendition monitor =s
rendition bell =
rendition silence =u
# Reverse video makes the otherwise blank separator cells visible.
rendition so =r
